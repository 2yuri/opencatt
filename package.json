{
  "name": "opencat",
  "productName": "OpenCatt",
  "version": "0.2.0",
  "description": "Open source desktop app that drafts and schedules posts on X, driven by a chat agent.",
  "license": "MIT",
  "author": "OpenCatt contributors",
  "homepage": "https://github.com/2yuri/opencatt",
  "repository": "github:2yuri/opencatt",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "dist": "bash scripts/ffmpeg/fetch.sh && pnpm build && electron-builder --publish never",
    "dist:mac": "bash scripts/ffmpeg/fetch.sh darwin-arm64 darwin-x64 && pnpm build && electron-builder --mac --publish never",
    "dist:win": "bash scripts/ffmpeg/fetch.sh win32-x64 && pnpm build && electron-builder --win --publish never",
    "dist:linux": "bash scripts/ffmpeg/fetch.sh linux-x64 && pnpm build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/twitter-text": "^3.1.10",
    "@vitejs/plugin-react": "^5.2.0",
    "date-fns": "^4.4.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.48.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "twitter-text": "3.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  }
}
